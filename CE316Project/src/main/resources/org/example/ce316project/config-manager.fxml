<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.3" prefHeight="400.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ce316project.ConfigManagerController">
    <items>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label style="-fx-font-weight: bold;" text="Saved Configurations" />
            <ListView fx:id="configListView" VBox.vgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCreateNew" text="+ New Configuration" />
        </VBox>

        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label style="-fx-font-weight: bold;" text="Configuration Details" />

            <GridPane hgap="10.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <Label text="Configuration Name:" />
                    <TextField fx:id="nameField" GridPane.columnIndex="1" />

                    <Label text="Compiler Path:" GridPane.rowIndex="1" />
                    <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <children>
                            <TextField fx:id="compilerPathField" HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" onAction="#handleBrowseCompiler" text="..." />
                        </children>
                    </HBox>

                    <Label text="Compiler Args:" GridPane.rowIndex="2" />
                    <TextField fx:id="compilerArgsField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Run Command:" GridPane.rowIndex="3" />
                    <TextField fx:id="runCmdField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </children>
            </GridPane>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="BOTTOM_RIGHT" spacing="10.0">
                <children>
                    <Button mnemonicParsing="false" onAction="#handleDelete" style="-fx-text-fill: red;" text="Delete" />
                    <Button mnemonicParsing="false" onAction="#handleSave" style="-fx-base: #4CAF50; -fx-font-weight: bold;" text="Save Configuration" />
                </children>
            </HBox>
        </VBox>
    </items>
</SplitPane>